{
  "name": "app",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "yarn@4.19.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "resolutions": {
    "@esbuild-kit/core-utils/esbuild": "0.28.2",
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-focus-scope": "1.3.1"
  },
  "workspaces": [
    "eslint-rules",
    "integration-tests",
    "back",
    "front",
    "module",
    "utils"
  ],
  "scripts": {
    "lint": "bash scripts/ci/lint.sh",
    "lint:fix": "bash scripts/ci/lint.sh --fix",
    "lint:lint": "cd \"${INIT_CWD}\" && eslint --max-warnings 0 .",
    "lint:lint:fix": "cd \"${INIT_CWD}\" && eslint --fix .",
    "ts:check": "cd \"${INIT_CWD}\" && tsc --noEmit ${TSC_EXTRA_FLAGS:-}",
    "check-ts": "run ts:check && yarn workspaces foreach -Apt -vv run check-ts",
    "dev": "yarn workspaces foreach -Apti -vv run dev",
    "test": "yarn workspaces foreach -Apt -vv --exclude @app/integration-tests run test",
    "test:full": "yarn workspaces foreach -Apt -vv run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "ci": "yarn workspaces foreach -Apt -vv --exclude @app/integration-tests run ci && yarn knip",
    "audit:deps": "yarn npm audit --all --recursive --environment production --severity high",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "env:up": "node scripts/devenv.mjs up",
    "env:status": "node scripts/devenv.mjs status",
    "env:down": "node scripts/devenv.mjs down",
    "env:logs": "node scripts/devenv.mjs logs",
    "env:ports": "node scripts/devenv.mjs ports",
    "env:snapshot": "node scripts/devenv.mjs snapshot",
    "env:restore": "node scripts/devenv.mjs restore",
    "env:snapshots": "node scripts/devenv.mjs snapshots",
    "perf:estate": "node scripts/perf/estate-bench.mjs",
    "xtm-one-contract": "node scripts/xtm-one-contract.mjs",
    "agent:build": "node scripts/render-agent-files.mjs",
    "agent:check": "node scripts/render-agent-files.mjs --check",
    "notice:build": "node scripts/notice.mjs",
    "notice:check": "node scripts/notice.mjs --check",
    "release:version": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/json": "2.1.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-lingui": "0.16.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sort": "4.0.0",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "knip": "6.48.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "yaml": "2.9.1"
  }
}
