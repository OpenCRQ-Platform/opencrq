msgstr "<0/> findings uniques de CVE au cours des {days} derniers jours ({previousCveGroups} auparavant)"

msgid "<0/> findings over the last {days} days ({previousFindings} previously)"
msgstr "<0/> findings au cours des {days} derniers jours ({previousFindings} auparavant)"

msgid "<0/> vs the previous {days} days ({previousNew} then)"
msgstr "<0/> par rapport aux {days} jours précédents ({previousNew} alors)"

msgid "<0>{changeLabel}</0> since {oldestScore} on {oldestDate}"
msgstr "<0>{changeLabel}</0> depuis {oldestScore} le {oldestDate}"

msgid "<0>{cveId}</0> <1>on</1> <2/>"
