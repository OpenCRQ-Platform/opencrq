msgid "Absorbed an ask"
msgstr "A absorbé une demande"

msgid "Absorbed ask"
msgstr "Demande absorbée"

msgid "Access control, HVAC or other building system"
msgstr "Contrôle d’accès, CVC ou autre système du bâtiment"

