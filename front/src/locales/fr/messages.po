msgstr "<0>{outside}</0> <1>{outside, plural, one {scénario} other {scénarios}} sur {assessed}</1>"

msgid "<0>γ = 0.7</0> — recommended default: extra controls add value but with diminishing returns."
msgstr "<0>γ = 0,7</0> — valeur par défaut recommandée : les contrôles supplémentaires apportent de la valeur, mais avec des rendements décroissants."

msgid "<0>γ = 0</0> — only the single strongest control on a technique is counted (conservative \"max\" aggregation)."
msgstr "<0>γ = 0</0> — seul le contrôle le plus fort d'une technique est pris en compte (agrégation « max » conservatrice)."

msgid "<0>γ = 1</0> — every stacked control counts fully (most optimistic about defense-in-depth)."
msgstr "<0>γ = 1</0> — chaque contrôle cumulé compte pleinement (hypothèse la plus optimiste sur la défense en profondeur)."

