OPENCRQ_IMAGE=docker.io/filigran/opencrq:rolling

# PostgreSQL Configuration
POSTGRES__HOST=postgres
POSTGRES__PORT=5432
POSTGRES__USER=opencrq
POSTGRES__PASSWORD=changeme
POSTGRES__DATABASE=opencrq

# File Storage Configuration
FILE_STORAGE__ENDPOINT=http://rustfs:9000
FILE_STORAGE__ACCESS_KEY=opencrq
FILE_STORAGE__SECRET_KEY=opencrq123
FILE_STORAGE__BUCKET=opencrq
FILE_STORAGE__REGION=eu-west-3

# Backend API Configuration
HTTP_SERVER__PUBLIC_PORT=3020

# Telemetry Configuration (docs/deployment/configuration.md#telemetry)
# Anonymous usage statistics sent to Filigran (docs/deployment/usage-telemetry.md); false = nothing is sent
# TELEMETRY__USAGE__ENABLED=true

# Your own observability tools
TELEMETRY__OBSERVABILITY__SERVICE_NAME=opencrq-platform

TELEMETRY__OBSERVABILITY__OTLP__TRACES__ENABLED=false
TELEMETRY__OBSERVABILITY__OTLP__TRACES__EXPORTER=http://otel-collector:4317

TELEMETRY__OBSERVABILITY__OTLP__METRICS__ENABLED=false
TELEMETRY__OBSERVABILITY__OTLP__METRICS__EXPORTER=http://otel-collector:4317

TELEMETRY__OBSERVABILITY__OTLP__LOGS__ENABLED=false
TELEMETRY__OBSERVABILITY__OTLP__LOGS__EXPORTER=http://otel-collector:4317

TELEMETRY__OBSERVABILITY__PROMETHEUS__ENABLED=false

TELEMETRY__OBSERVABILITY__PYROSCOPE__ENABLED=false
TELEMETRY__OBSERVABILITY__PYROSCOPE__SERVER_ADDRESS=http://pyroscope:4040

HEALTHCHECK_HTTP_SERVER__PUBLIC_PORT=8444

# XTM One (required) — the platform refuses to start without these three set.
XTM_ONE__URL=
XTM_ONE__TOKEN=
XTM_ONE__PLATFORM_URL=

# Connectors Configuration (uncomment and set values to enable). Each field is its own flat env
# var, keyed by the target tenant's UUID (visible in its URL /$tenantId/...). Replace the example
# UUID below with the UUID of the tenant the connector feeds.
# CONNECTORS__NIST__01a043da-ff47-72c2-aaa4-7da56d85c83e__API_KEY=
# CONNECTORS__MICROSOFT_GRAPH__01a043da-ff47-72c2-aaa4-7da56d85c83e__AZURE_TENANT_ID=
# CONNECTORS__MICROSOFT_GRAPH__01a043da-ff47-72c2-aaa4-7da56d85c83e__CLIENT_ID=
# CONNECTORS__MICROSOFT_GRAPH__01a043da-ff47-72c2-aaa4-7da56d85c83e__CLIENT_SECRET=
# CONNECTORS__OPENAEV__01a043da-ff47-72c2-aaa4-7da56d85c83e__URL=
# CONNECTORS__OPENAEV__01a043da-ff47-72c2-aaa4-7da56d85c83e__TOKEN=
# CONNECTORS__OPENCTI__01a043da-ff47-72c2-aaa4-7da56d85c83e__URL=
# CONNECTORS__OPENCTI__01a043da-ff47-72c2-aaa4-7da56d85c83e__TOKEN=
# CONNECTORS__DRATA__01a043da-ff47-72c2-aaa4-7da56d85c83e__API_KEY=
