    "@types/nconf": "0.10.7",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "pg-pool": "3.14.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
