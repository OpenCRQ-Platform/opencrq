{
  "name": "@app/back",
  "private": true,
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "yarn@4.19.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx esbuild.ts --start --watch --development",
    "build": "tsx esbuild.ts",
    "seed:setup-dev": "tsx scripts/seed-setup-dev.ts",
    "seed:rollback-dev": "tsx scripts/seed-rollback-dev.ts",
    "env:reset": "tsx scripts/env-reset.ts",
    "lint": "run lint:lint",
    "lint:fix": "run lint:lint:fix",
    "check-ts": "run ts:check",
    "ci": "run check-ts && run lint",
    "test": "vitest run",
    "trpc:manifest": "vitest run src/features/app-router/procedure-manifest.test.ts --update"
  },
  "dependencies": {
    "@app/module": "workspace:*",
    "@app/utils": "workspace:*",
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/lib-storage": "3.1176.0",
    "@fastify/compress": "9.3.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.9",
    "@fastify/static": "10.1.12",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-prometheus": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@opentelemetry/winston-transport": "0.35.0",
    "@pyroscope/nodejs": "0.7.1",
    "@smithy/node-http-handler": "4.14.2",
    "@trpc/server": "11.31.0",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "nconf": "0.13.0",
    "pg": "8.23.1",
    "ts-deepmerge": "8.0.0",
    "uuidv7": "1.2.1",
    "winston": "3.19.0",
    "zod": "4.6.7"
