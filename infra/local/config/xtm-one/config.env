PLATFORM_MODE=xtm_one
DATABASE_URL=postgresql+asyncpg://xtm_one:xtm_one@postgres:5432/xtm_one
REDIS_URL=redis://redis:6379
S3_ENDPOINT=rustfs:9000
S3_ACCESS_KEY=app-dev
S3_SECRET_KEY=app-dev-secret
S3_BUCKET=xtm-one
S3_USE_SSL=false
SMTP_HOSTNAME=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_FROM=xtm-one@example.com
SMTP_FROM_NAME=XTM One
# A local stack is not where Filigran's Terms of Use are accepted, and the gate refuses every API call
# until they are, the seed's included: the switch XTM One provides for self-hosted installs.
TERMS_OF_USE_ENABLED=false
