{
  "title": "OpenCRQ tRPC Performance",
  "uid": "opencrq-trpc-performance",
  "editable": true,
  "tags": [],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "tRPC latency (all procedures)",
      "description": "opencrq.trpc.server.duration carries no trpc_procedure label: which call got slow is on the Slow tRPC calls log panel below instead.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by(le) (rate(opencrq_trpc_server_duration_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by(le) (rate(opencrq_trpc_server_duration_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(opencrq_trpc_server_duration_sum[$__rate_interval])) / sum(rate(opencrq_trpc_server_duration_count[$__rate_interval]))",
          "legendFormat": "avg",
          "editorMode": "code",
          "range": true
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "tRPC request rate by procedure",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(trpc_procedure) (rate(opencrq_trpc_server_calls_total[$__rate_interval]))",
          "legendFormat": "{{trpc_procedure}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "tRPC error rate by procedure",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by(trpc_procedure, error_type) (rate(opencrq_trpc_server_calls_total{error_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{trpc_procedure}} ({{error_type}})",
          "editorMode": "code",
          "range": true
        }
      ],
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "DB query p95 by operation",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by(le, db_operation_name) (rate(db_client_operation_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{db_operation_name}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Slow tRPC calls (>= 500ms)",
      "description": "The log line the middleware writes for a call over the threshold, with its procedure, duration and item count — the substitute for per-procedure latency, which opencrq.trpc.server.duration no longer carries.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\".+\"} |= \"Slow tRPC call\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
