# Copy to `.env` (gitignored) and adjust to run this stack alongside another
# worktree's without name/port collisions. Every value defaults to the one
# below when `.env` is absent or the variable is unset.

# Suffix applied to the Compose project name and every container name
# (e.g. "-worktree2" -> app-dev-worktree2, app-dev-postgres-worktree2).
INSTANCE_SUFFIX=

POSTGRES_PORT=5432
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Only used with `podman compose --profile monitoring up -d`.
PYROSCOPE_PORT=4040
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3020
